{
  "$schema": "https://opencode.ai/config.json",
  "model": "pinnacles/nemotron-3-super",
  "small_model": "pinnacles/nemotron-3-super",
  "enabled_providers": ["pinnacles"],
  "share": "disabled",
  "autoupdate": false,
  "provider": {
    "pinnacles": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Pinnacles GPU",
      "options": {"baseURL": "http://127.0.0.1:8000/v1"},
      "models": {
        "nemotron-3-super": {
          "name": "NVIDIA Nemotron 3 Super (H200)",
          "limit": {"context": 32768, "output": 8192},
          "reasoning": true,
          "options": {"chat_template_kwargs": {"enable_thinking": true, "low_effort": false}},
          "variants": {
            "medium": {"disabled": true},
            "none": {"chat_template_kwargs": {"enable_thinking": false, "low_effort": false}},
            "low": {"chat_template_kwargs": {"enable_thinking": true, "low_effort": true}},
            "high": {"chat_template_kwargs": {"enable_thinking": true, "low_effort": false}}
          }
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow"
  }
}
