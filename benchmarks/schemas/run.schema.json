{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rornelas2/OpenSource_Agentic_Model_Setup/benchmarks/schemas/run.schema.json",
  "title": "Immutable benchmark run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "campaign_id", "profile_id", "suite_id", "pilot",
    "protocol_status", "repository", "input_sha256", "model", "runtime", "opencode",
    "endpoint", "hardware", "allocation", "suite", "sampling", "reasoning", "cache",
    "budgets", "execution_policy", "scheduled_task_ids", "raw_artifact_root",
    "workspace_root", "preparation_manifest", "preparation_manifest_sha256",
    "server_argv", "started_utc", "ended_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "campaign_id": {"type": "string", "minLength": 1},
    "profile_id": {"type": "string", "minLength": 1},
    "suite_id": {"type": "string", "minLength": 1},
    "pilot": {"type": "boolean"},
    "protocol_status": {"enum": ["candidate", "frozen"]},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"type": "boolean"}}
    },
    "input_sha256": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "model": {"type": "object"},
    "runtime": {"type": "object"},
    "opencode": {"type": "object"},
    "endpoint": {"type": "object"},
    "hardware": {"type": "object"},
    "allocation": {"type": "object"},
    "suite": {"type": "object"},
    "sampling": {"type": "object"},
    "reasoning": {"type": "object"},
    "cache": {"type": "object"},
    "budgets": {"type": "object"},
    "execution_policy": {"type": "object"},
    "scheduled_task_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 256}
    },
    "raw_artifact_root": {"type": "string", "minLength": 1},
    "workspace_root": {"type": "string", "minLength": 1},
    "preparation_manifest": {"type": "string", "minLength": 1},
    "preparation_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "server_argv": {
      "type": "array", "minItems": 1,
      "items": {"type": "string"}
    },
    "started_utc": {"type": ["string", "null"], "format": "date-time"},
    "ended_utc": {"type": ["string", "null"], "format": "date-time"}
  }
}
